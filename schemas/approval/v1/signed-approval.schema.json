{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/approval/v1/signed-approval.schema.json",
  "title": "JARVIS Signed Approval Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "algorithm",
    "key_id",
    "approver_id",
    "issued_at_utc_ns",
    "expires_at_utc_ns",
    "grant",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "jarvis.signed-approval"
    },
    "version": {
      "const": 1
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "approver_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "issued_at_utc_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709552000
    },
    "expires_at_utc_ns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709552000
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "approved_by",
        "approval_ref",
        "manager_id",
        "task_id",
        "task_revision",
        "session_id",
        "session_revision",
        "plan_id",
        "step_id",
        "action_id",
        "capability",
        "scope",
        "idempotency_key",
        "policy_id",
        "policy_version",
        "policy_digest",
        "intent_digest",
        "expires_at_ns"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "approved_by": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "manager_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "task_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709552000
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "session_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709552000
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "action_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "policy_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709552000
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "intent_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709552000
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
