{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-ans100.invalid/schemas/workspace/v1/workspace-backup.schema.json",
  "title": "JARVIS Encrypted Workspace Backup Payload V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "backup_id",
    "created_at",
    "source_platform",
    "workspace",
    "integrity"
  ],
  "properties": {
    "format": {
      "const": "jarvis.workspace.backup"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      }
    },
    "backup_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_platform": {
      "enum": [
        "desktop",
        "android"
      ]
    },
    "workspace": {
      "$ref": "workspace.schema.json"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
