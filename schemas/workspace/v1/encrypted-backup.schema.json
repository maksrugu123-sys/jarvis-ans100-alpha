{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-ans100.invalid/schemas/workspace/v1/encrypted-backup.schema.json",
  "title": "JARVIS Encrypted Workspace Backup Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "kdf",
    "cipher",
    "ciphertext"
  ],
  "properties": {
    "format": {
      "const": "jarvis.workspace.backup.encrypted"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      }
    },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "iterations",
        "salt"
      ],
      "properties": {
        "name": {
          "const": "PBKDF2-HMAC-SHA256"
        },
        "iterations": {
          "const": 310000
        },
        "salt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{22}==$"
        }
      }
    },
    "cipher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "nonce",
        "tag_bits"
      ],
      "properties": {
        "name": {
          "const": "AES-256-GCM"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{16}$"
        },
        "tag_bits": {
          "const": 128
        }
      }
    },
    "ciphertext": {
      "type": "string",
      "minLength": 24,
      "maxLength": 22369644,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}
