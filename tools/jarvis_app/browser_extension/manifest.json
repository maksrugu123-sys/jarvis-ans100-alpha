{
  "manifest_version": 3,
  "name": "JARVIS Browser Bridge",
  "version": "1.0.0",
  "description": "Explicit, user-triggered browser actions for the local JARVIS ANS-100 assistant.",
  "action": {
    "default_title": "JARVIS Browser Bridge",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ]
}
